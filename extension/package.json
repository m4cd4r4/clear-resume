{
  "name": "cornerman",
  "displayName": "cornerman",
  "description": "Browse your Claude Code handovers and resume one in a fresh conversation.",
  "version": "0.7.0",
  "publisher": "macdara",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0A0A0A",
    "theme": "dark"
  },
  "homepage": "https://github.com/m4cd4r4/cornerman/tree/main/extension#readme",
  "bugs": {
    "url": "https://github.com/m4cd4r4/cornerman/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/m4cd4r4/cornerman",
    "directory": "extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "AI"
  ],
  "keywords": [
    "claude",
    "claude code",
    "ai agent",
    "handover",
    "resume",
    "sessions",
    "context",
    "sidebar",
    "relay",
    "worktrees",
    "context window",
    "productivity"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:cornerman.history",
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cornerman",
          "title": "cornerman",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "cornerman": [
        {
          "id": "cornerman.history",
          "name": "Handovers",
          "contextualTitle": "cornerman",
          "type": "webview"
        },
        {
          "id": "cornerman.lanes",
          "name": "Worktrees",
          "contextualTitle": "cornerman",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "cornerman.resume",
        "title": "Resume",
        "icon": "$(play)"
      },
      {
        "command": "cornerman.pin",
        "title": "Pin",
        "icon": "$(pin)"
      },
      {
        "command": "cornerman.unpin",
        "title": "Unpin",
        "icon": "$(pinned)"
      },
      {
        "command": "cornerman.delete",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "cornerman.open",
        "title": "Open handover"
      },
      {
        "command": "cornerman.openLoaded",
        "title": "Open loaded handover"
      },
      {
        "command": "cornerman.asset",
        "title": "Open what the session left on screen"
      },
      {
        "command": "cornerman.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "cornerman.toggleArchived",
        "title": "Show/hide archived",
        "icon": "$(history)"
      },
      {
        "command": "cornerman.migrate",
        "title": "cornerman: Import existing handovers"
      },
      {
        "command": "cornerman.openLane",
        "title": "Open worktree window",
        "category": "cornerman"
      },
      {
        "command": "cornerman.pickRelay",
        "title": "Set relay for this window",
        "category": "cornerman"
      },
      {
        "command": "cornerman.pickNudge",
        "title": "Set nudge size for this window",
        "category": "cornerman"
      },
      {
        "command": "cornerman.pickIdle",
        "title": "Set idle handover mode",
        "category": "cornerman"
      },
      {
        "command": "cornerman.handoverNow",
        "title": "Hand over now",
        "category": "cornerman"
      },
      {
        "command": "cornerman.spareAct",
        "title": "Spare Cycles: Done / Skip / Snooze",
        "category": "cornerman"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "cornerman.resume",
          "when": "false"
        },
        {
          "command": "cornerman.pin",
          "when": "false"
        },
        {
          "command": "cornerman.unpin",
          "when": "false"
        },
        {
          "command": "cornerman.delete",
          "when": "false"
        },
        {
          "command": "cornerman.open",
          "when": "false"
        },
        {
          "command": "cornerman.openLoaded",
          "when": "false"
        },
        {
          "command": "cornerman.asset",
          "when": "false"
        },
        {
          "command": "cornerman.migrate",
          "when": "cornerman.hasLegacy"
        },
        {
          "command": "cornerman.openLane",
          "when": "false"
        },
        {
          "command": "cornerman.spareAct",
          "when": "config.cornerman.spareCycles"
        }
      ],
      "view/title": [
        {
          "command": "cornerman.toggleArchived",
          "when": "view == cornerman.history",
          "group": "navigation@1"
        },
        {
          "command": "cornerman.refresh",
          "when": "view == cornerman.history",
          "group": "navigation@2"
        },
        {
          "command": "cornerman.refresh",
          "when": "view == cornerman.lanes",
          "group": "navigation"
        }
      ],
      "webview/context": [
        {
          "command": "cornerman.open",
          "when": "webviewSection == 'handover'",
          "group": "1_open@1"
        },
        {
          "command": "cornerman.resume",
          "when": "webviewSection == 'handover' && !archived",
          "group": "2_act@1"
        },
        {
          "command": "cornerman.pin",
          "when": "webviewSection == 'handover' && !pinned",
          "group": "2_act@2"
        },
        {
          "command": "cornerman.unpin",
          "when": "webviewSection == 'handover' && pinned",
          "group": "2_act@2"
        },
        {
          "command": "cornerman.delete",
          "when": "webviewSection == 'handover'",
          "group": "3_delete@1"
        },
        {
          "command": "cornerman.openLane",
          "when": "webviewSection == 'lane'",
          "group": "1_open@1"
        }
      ]
    },
    "configuration": {
      "title": "cornerman",
      "properties": {
        "cornerman.storePath": {
          "type": "string",
          "default": "",
          "description": "Folder holding the handover store. Defaults to ~/.cornerman."
        },
        "cornerman.showArchived": {
          "type": "boolean",
          "default": false,
          "description": "Show archived handovers in the tree."
        },
        "cornerman.registryPath": {
          "type": "string",
          "default": "",
          "description": "Optional worktree registry (JSON with an entries array). When set, the Worktrees view labels each worktree by its plan row and lists queued entries as Next up."
        },
        "cornerman.spareCycles": {
          "type": "boolean",
          "default": false,
          "description": "Show the Spare Cycles timer in the status bar: a countdown to the next task, Done / Skip / Snooze on click, and one notification when a task comes due. Needs the spare-cycles plugin, which owns the timer."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.4.0"
  }
}
