{
  "name": "clear-resume",
  "displayName": "clear-resume",
  "description": "Browse your Claude Code handovers and resume one in a fresh conversation.",
  "version": "0.4.0",
  "publisher": "macdara",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1E2536",
    "theme": "dark"
  },
  "homepage": "https://github.com/m4cd4r4/clear-resume/tree/main/extension#readme",
  "bugs": {
    "url": "https://github.com/m4cd4r4/clear-resume/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/m4cd4r4/clear-resume",
    "directory": "extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "AI"
  ],
  "keywords": [
    "claude",
    "claude code",
    "ai agent",
    "handover",
    "resume",
    "sessions",
    "context",
    "sidebar",
    "productivity"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:clearResume.history",
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "clearResume",
          "title": "clear-resume",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "clearResume": [
        {
          "id": "clearResume.history",
          "name": "Handovers",
          "contextualTitle": "clear-resume"
        },
        {
          "id": "clearResume.lanes",
          "name": "Worktrees",
          "contextualTitle": "clear-resume"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "clearResume.history",
        "when": "clearResume.hasLegacy",
        "contents": "No handovers yet.\n\nWrite one with the /clear-resume:handover skill, or import the ones you already have.\n[Import existing handovers](command:clearResume.migrate)"
      },
      {
        "view": "clearResume.history",
        "when": "!clearResume.hasLegacy",
        "contents": "No handovers yet.\n\nWrite one with the /clear-resume:handover skill."
      }
    ],
    "commands": [
      {
        "command": "clearResume.resume",
        "title": "Resume",
        "icon": "$(play)"
      },
      {
        "command": "clearResume.pin",
        "title": "Pin",
        "icon": "$(pin)"
      },
      {
        "command": "clearResume.unpin",
        "title": "Unpin",
        "icon": "$(pinned)"
      },
      {
        "command": "clearResume.delete",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "clearResume.open",
        "title": "Open handover"
      },
      {
        "command": "clearResume.openLoaded",
        "title": "Open loaded handover"
      },
      {
        "command": "clearResume.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "clearResume.toggleArchived",
        "title": "Show/hide archived",
        "icon": "$(history)"
      },
      {
        "command": "clearResume.migrate",
        "title": "clear-resume: Import existing handovers"
      },
      {
        "command": "clearResume.openLane",
        "title": "Open worktree window",
        "category": "clear-resume"
      },
      {
        "command": "clearResume.pickRelay",
        "title": "Set relay for this window",
        "category": "clear-resume"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "clearResume.resume",
          "when": "false"
        },
        {
          "command": "clearResume.pin",
          "when": "false"
        },
        {
          "command": "clearResume.unpin",
          "when": "false"
        },
        {
          "command": "clearResume.delete",
          "when": "false"
        },
        {
          "command": "clearResume.open",
          "when": "false"
        },
        {
          "command": "clearResume.openLoaded",
          "when": "false"
        },
        {
          "command": "clearResume.migrate",
          "when": "clearResume.hasLegacy"
        },
        {
          "command": "clearResume.openLane",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "clearResume.toggleArchived",
          "when": "view == clearResume.history",
          "group": "navigation@1"
        },
        {
          "command": "clearResume.refresh",
          "when": "view == clearResume.history",
          "group": "navigation@2"
        },
        {
          "command": "clearResume.refresh",
          "when": "view == clearResume.lanes",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "clearResume.resume",
          "when": "view =~ /^clearResume\\.(history|lanes)$/ && viewItem =~ /^(handover|loaded):/",
          "group": "inline@1"
        },
        {
          "command": "clearResume.pin",
          "when": "view =~ /^clearResume\\.(history|lanes)$/ && viewItem =~ /:unpinned$/",
          "group": "inline@2"
        },
        {
          "command": "clearResume.unpin",
          "when": "view =~ /^clearResume\\.(history|lanes)$/ && viewItem =~ /:pinned$/",
          "group": "inline@2"
        },
        {
          "command": "clearResume.delete",
          "when": "view =~ /^clearResume\\.(history|lanes)$/ && viewItem =~ /^(handover|loaded):/",
          "group": "inline@3"
        }
      ]
    },
    "configuration": {
      "title": "clear-resume",
      "properties": {
        "clearResume.storePath": {
          "type": "string",
          "default": "",
          "description": "Folder holding the handover store. Defaults to ~/.clear-resume."
        },
        "clearResume.showArchived": {
          "type": "boolean",
          "default": false,
          "description": "Show archived handovers in the tree."
        },
        "clearResume.registryPath": {
          "type": "string",
          "default": "",
          "description": "Optional worktree registry (JSON with an entries array). When set, the Worktrees view labels each worktree by its plan row and lists queued entries as Next up."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.4.0"
  }
}
