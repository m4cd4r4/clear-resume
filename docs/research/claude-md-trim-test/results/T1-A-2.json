 "patch": "diff --git a/app/pricing/page.tsx b/app/pricing/page.tsx\nindex ecb1dfd6..26bea2bf 100644\n--- a/app/pricing/page.tsx\n+++ b/app/pricing/page.tsx\n@@ -134,12 +134,57 @@ const FAQ: FaqItem[] = [\n   },\n ];\n \n+/* CUSTOM QUESTIONS. Every fact reads from WEB_TIERS / WEB_ADDONS, so a\n+ * reprice or a scope change lands here without an edit. */\n+const CUSTOM_FAQ: FaqItem[] = [\n+  {\n+    q: `What do I get on ${CUSTOM.name} that ${STARTER.name} does not have?`,\n+    a: `${CUSTOM.scope}, with type, layout and motion drawn for your brand alone. ${STARTER.name} is one page on a ready-made site. Site search is built in on ${CUSTOM.name}, at no extra fee.`,\n+  },\n+  {\n+    q: `Do I need my own photos for ${CUSTOM.name}?`,\n+    a: `Yes. Photography is yours, and we design the site around it. We do not provide the images.`,\n+  },\n+  {\n+    q: `What can I add to a ${CUSTOM.name} site, and what does it cost?`,\n+    a: `${WEB_ADDONS.map((x) => `${x.name} is +${x.price}`).join(\", \")}. Each is priced and agreed in writing with your quote, before we start.`,\n+  },\n+];\n+\n const faqLd = {\n   \"@context\": \"https://schema.org\",\n   \"@type\": \"FAQPage\",\n-  mainEntity: FAQ.map(({ q, a }) => ({ \"@type\": \"Question\", name: q, acceptedAnswer: { \"@type\": \"Answer\", text: a } })),\n+  mainEntity: [...FAQ, ...CUSTOM_FAQ].map(({ q, a }) => ({ \"@type\": \"Question\", name: q, acceptedAnswer: { \"@type\": \"Answer\", text: a } })),\n };\n \n+function FaqList({ items }: { items: FaqItem[] }) {\n+  return (\n+    <div>\n+      {items.map(({ q, a, more }) => (\n+        <details key={q} className=\"group border-t border-line last:border-b\">\n+          <summary className=\"flex cursor-pointer list-none items-start justify-between gap-4 py-4 text-base font-semibold tracking-tight marker:content-none [&::-webkit-details-marker]:hidden\">\n+            {q}\n+            <span aria-hidden className=\"mt-0.5 flex-none text-fg-3 group-open:rotate-45\">\n+              +\n+            </span>\n+          </summary>\n+          <p className=\"max-w-[68ch] pb-5 text-sm leading-relaxed text-fg-2\">\n+            {a}\n+            {more && (\n+              <>\n+                {\" \"}\n+                <a href={more.href} className=\"font-medium text-accent-text underline-offset-4 hover:underline\">\n+                  {more.label}\n+                </a>\n+              </>\n+            )}\n+          </p>\n+        </details>\n+      ))}\n+    </div>\n+  );\n+}\n+\n function Thumbs({ items }: { items: { key: string; src: string; href: string; label: string }[] }) {\n   return (\n     <ul className=\"grid grid-cols-4 gap-3\">\n@@ -303,27 +348,17 @@ export default function PricingPage() {\n               </li>\n             </ul>\n             <div className=\"lg:col-span-7\">\n-              {FAQ.map(({ q, a, more }) => (\n-                <details key={q} className=\"group border-t border-line last:border-b\">\n-                  <summary className=\"flex cursor-pointer list-none items-start justify-between gap-4 py-4 text-base font-semibold tracking-tight marker:content-none [&::-webkit-details-marker]:hidden\">\n-                    {q}\n-                    <span aria-hidden className=\"mt-0.5 flex-none text-fg-3 group-open:rotate-45\">\n-                      +\n-                    </span>\n-                  </summary>\n-                  <p className=\"max-w-[68ch] pb-5 text-sm leading-relaxed text-fg-2\">\n-                    {a}\n-                    {more && (\n-                      <>\n-                        {\" \"}\n-                        <a href={more.href} className=\"font-medium text-accent-text underline-offset-4 hover:underline\">\n-                          {more.label}\n-                        </a>\n-                      </>\n-                    )}\n-                  </p>\n-                </details>\n-              ))}\n+              <FaqList items={FAQ} />\n+            </div>\n+          </di